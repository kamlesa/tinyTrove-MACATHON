{
  "expo": {
    "name": "MACATHON 2026",
    "slug": "macathon-2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow MACATHON 2026 to access your location"
        }
      ],
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar"
    ]
  }
}
